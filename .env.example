# APPLICATION
APP_ENV=development
APP_PORT=8000

# LA SEULE CLE QUI PROTEGE ENCORE QUELQUE CHOSE
# Elle ouvre /api et /v1, c'est-a-dire ARENA lui-meme. Sans elle, la passerelle
# est desactivee par securite — elle ne demarre pas « ouverte ».
# Generer une valeur unique :  python -c "import secrets; print(secrets.token_urlsafe(32))"
USMAN_API_KEY=
# Origines autorisees a appeler /api et /v1 depuis un navigateur (CORS).
# Liste separee par des virgules. Ne jamais mettre "*".
USMAN_ALLOWED_ORIGINS=http://localhost:8000

# CLES RETIREES LE 2026-08-28 — NE PLUS LES REMETTRE
# CREDS_KEY, JWT_SECRET, JWT_REFRESH_SECRET et WEBUI_SECRET_KEY servaient a
# LibreChat et Open WebUI. Le proprietaire a sa propre interface : les deux
# services sont retires du depot, et ces quatre valeurs n'ouvrent plus rien.
# Elles avaient fuite dans l'historique public ; les supprimer d'ici est ce qui
# rend cette fuite definitivement sans effet.
# SECRET_KEY est partie avec elles : aucune ligne de code ne la lisait. Une
# securite morte qui ressemble a une securite est pire qu'aucune.

# GOOGLE — COURRIER (chapitre 8) ET AGENDA (chapitre 9)
# UN SEUL identifiant pour les deux : ce qui change entre eux est la portee
# accordee, pas le client.
# Sur console.cloud.google.com : activer l'API Gmail ET l'API Google Calendar,
# remplir l'ecran de consentement, creer un identifiant OAuth « application de
# bureau ».
#
# Les portees, a n'accorder que si tu veux la capacite :
#   gmail.readonly     lire et trier ton courrier
#   gmail.send         envoyer — chaque envoi te demande confirmation
#   calendar.readonly  voir tes rendez-vous et tes creneaux libres
#   calendar.events    poser un rendez-vous — la confirmation s'applique aussi
#
# Sans ces valeurs, ARENA rapporte NOT_CONFIGURED : il ne fait jamais semblant
# d'avoir une boite vide ni une semaine libre.
# Aucune de ces valeurs ne s'ecrit dans le depot.
# (Les anciens noms GMAIL_* restent acceptes si ton .env les porte deja.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Ta journee de travail, telle que l'agenda doit la lire. Declaree ici plutot
# que devinee : proposer un creneau a 3 h du matin serait exact et inutilisable.
AGENDA_HEURE_DEBUT=8
AGENDA_HEURE_FIN=18

# VIDEO COURTE — MoneyPrinterTurbo (service separe, lance par toi)
# Il fabrique une video verticale a partir d'un sujet : script, plans, voix,
# sous-titres, montage. ARENA lui parle par son API ; aucune ligne de ce projet
# n'entre dans ce depot.
# Installation : scripts/installer_moneyprinter.ps1
# Lancement    : python -m uvicorn app.asgi:app --host 127.0.0.1 --port 8080
# ATTENTION, dans SON config.toml a lui (pas ici) :
#   llm_provider = "ollama"   <- sinon tes scripts video partent chez un
#                                fournisseur d'IA, ce que DEC-0002 refuse.
#   pexels_api_keys = [...]   <- sa banque de plans. Cle gratuite sur pexels.com.
MONEYPRINTER_URL=http://127.0.0.1:8080/api/v1
# Seulement s'il a mis une cle dans son [app] api_key. Vide sinon.
MONEYPRINTER_API_KEY=

# IA LOCALE (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LOCAL_MODEL=qwen3.5:9b
CODER_LOCAL_MODEL=qwen2.5-coder:14b

# MOTEUR OPTIONNEL CLOUD (Futur / Désactivé par défaut)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# PERMISSIONS & SÉCURITÉ
# Les permissions ne sont PAS dans ce fichier. Elles vivaient ici sous la forme
# PERM_READ_FILES, PERM_WRITE_FILES, PERM_EXECUTE_COMMANDS et PERM_AUTO_PUBLISH,
# et aucune n etait lue par le code : les regler ne changeait rien. Une securite
# morte qui ressemble a une securite est pire qu aucune, parce qu on lui fait
# confiance. Elles sont retirees le 2026-08-27.
#
# Deux fichiers, deux roles :
#   config/permissions.yaml            coupe-circuits generaux (9 booleens).
#                                      PUBLISH: false = rien ne se publie, nulle
#                                      part, quoi que dise l autre fichier.
#   config/permissions_services.yaml   le detail par compte, service, action et
#                                      risque. ALLOWED / CONFIRMATION / DENIED.
#
# La plus stricte des deux couches gagne, toujours.
# Repli hors bac a sable : execute le code genere directement sur la machine,
# sans isolation ni limite memoire, quand Docker est inactif.
# Laisser vide. Sans ce flag, ARENA refuse d executer plutot que de degrader.
ALLOW_UNSAFE_EXEC=

# ENVOI DE FICHIERS (/api/upload)
# Taille maximale d'un fichier envoye, en octets. Defaut : 2 Go.
# Seuls les formats audio et video sont acceptes, quelle que soit cette valeur.
USMAN_UPLOAD_MAX_BYTES=2147483648

# LIMITATION DE DEBIT (routes qui appellent le modele)
# Un appel a Ollama occupe la carte graphique plusieurs secondes.
# Au-dela de ce plafond, la reponse est 429 avec un en-tete Retry-After.
USMAN_RATE_LIMIT_REQUESTS=10
USMAN_RATE_LIMIT_WINDOW=60

# NETTOYAGE AUTO (Gestion espace disque)
MAX_MEDIA_STORAGE_GB=10
AUTO_CLEAN_TEMP_MEDIA=true
