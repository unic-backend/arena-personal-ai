# APPLICATION
# "production" ferme la documentation auto-generee de FastAPI (/docs, /redoc,
# /openapi.json) : elle n'a aucune dependance possible, donc aucune cle ne la
# protege — ne jamais la generer est ce qui la ferme (VOLET « ARENA en ligne »,
# phase 4.2). Mettre "development" seulement sur un poste qui n'est jamais
# joignable depuis Internet.
APP_ENV=production
APP_PORT=8000

# LA SEULE CLE QUI PROTEGE ENCORE QUELQUE CHOSE
# Elle ouvre /api et /v1, c'est-a-dire ARENA lui-meme. Sans elle, la passerelle
# est desactivee par securite — elle ne demarre pas « ouverte ».
# Generer une valeur unique :  python -c "import secrets; print(secrets.token_urlsafe(32))"
USMAN_API_KEY=
# Origines autorisees a appeler /api et /v1 depuis un navigateur (CORS).
# Liste separee par des virgules. Ne jamais mettre "*".
USMAN_ALLOWED_ORIGINS=http://localhost:8000

# Ou cette machine annonce son adresse du jour, pour que le telephone la
# trouve sans copier-coller. Le tunnel tire un nom au hasard a chaque
# demarrage : sans cette ligne, il faut recoller l'adresse a la main.
# Le serveur vise ne sert que d'annuaire — la conversation va DIRECTEMENT
# a cette machine (DEC-0040). Il reutilise USMAN_API_KEY ci-dessus.
# Laisser vide n'empeche rien de tourner : rien n'est annonce, c'est tout.
USMAN_ANNONCE_URL=

# Jeton personnel GitHub (portee 'repo'), pour le connecteur github (DEC-0073).
# github.com/settings/tokens -> Generate new token (classic) -> repo.
# Laisser vide n'empeche rien de tourner : le connecteur se declare
# NON_CONFIGURE et le reste d'ARENA continue.
USMAN_GITHUB_TOKEN=
# Depot que Dioumtoukay peut manipuler directement via l'API GitHub quand
# le PC est eteint et que le backend permanent ne possede pas le depot local.
# Format owner/repo. Optionnel : sans lui, l'agent doit recevoir DEPOT a chaque
# action distante.
USMAN_GITHUB_DEFAULT_REPO=

# Case (DEC-0092) : un ordinateur Linux isole et persistant, deploye
# separement (AGPL, jamais copie dans ARENA — docs/audits/case_audit.md).
# Laisser vide n'empeche rien de tourner : le connecteur `case` se declare
# NON_CONFIGURE si rien ne repond a cette adresse.
USMAN_CASE_URL=http://127.0.0.1:8787/v1
USMAN_CASE_TOKEN=

# CLES RETIREES LE 2026-08-28 — NE PLUS LES REMETTRE
# CREDS_KEY, JWT_SECRET, JWT_REFRESH_SECRET et WEBUI_SECRET_KEY servaient a
# LibreChat et Open WebUI. Le proprietaire a sa propre interface : les deux
# services sont retires du depot, et ces quatre valeurs n'ouvrent plus rien.
# Elles avaient fuite dans l'historique public ; les supprimer d'ici est ce qui
# rend cette fuite definitivement sans effet.
# SECRET_KEY est partie avec elles : aucune ligne de code ne la lisait. Une
# securite morte qui ressemble a une securite est pire qu'aucune.

# NETLIFY — TES SITES WEB (DEC-0180)
# Jeton d'acces personnel : app.netlify.com -> User settings -> Applications
# -> Personal access tokens -> New access token. Marche a suivre complete :
# docs/CONNECTER_MES_COMPTES.md. Vide = connecteur NON_CONFIGURE, rien ne part.
NETLIFY_AUTH_TOKEN=
# Le site vise par defaut (Site configuration -> Site ID). JARVIS peut lister
# les sites du compte pour le trouver.
NETLIFY_SITE_ID=

# GOOGLE — COURRIER (chapitre 8) ET AGENDA (chapitre 9)
# UN SEUL identifiant pour les deux : ce qui change entre eux est la portee
# accordee, pas le client.
#
# Sur console.cloud.google.com : activer l'API Gmail (et l'API Google
# Calendar quand l'agenda sera cable), remplir l'ecran de consentement, creer
# un identifiant OAuth de type « application web » (PAS « application de
# bureau » : le flux reel passe par une URI de redirection exacte que Google
# doit connaitre a l'avance — voir PUBLIC_BASE_URL ci-dessous). Ajoute cette
# URI de redirection dans la console : {PUBLIC_BASE_URL}/connectors/gmail/callback
# (par defaut : http://127.0.0.1:8000/connectors/gmail/callback).
#
# GOOGLE_CLIENT_ID et GOOGLE_CLIENT_SECRET seuls suffisent pour connecter
# Gmail : clique « Connecter » dans ARENA (chapitre 8.2), consens sur l'ecran
# Google, et GOOGLE_REFRESH_TOKEN s'ecrit ici tout seul. Le remplir a la main
# reste possible (identifiant deja obtenu autrement) mais n'est plus
# necessaire.
#
# Sans ces valeurs, ARENA rapporte NOT_CONFIGURED : il ne fait jamais semblant
# d'avoir une boite vide ni une semaine libre.
# Aucune de ces valeurs ne s'ecrit dans le depot.
# (Les anciens noms GMAIL_* restent acceptes si ton .env les porte deja.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# FICHE GOOGLE (Maps) — le meme identifiant Google que ci-dessus (DEC-0184).
# Reglages -> Connecteurs -> Google Business Profile -> Connecter ajoute la
# portee business.manage au jeton. Google doit aussi avoir ouvert les API
# Business Profile a ton projet : docs/CONNECTER_MES_COMPTES.md.
# Facultatifs : sans eux, JARVIS prend le premier compte et la premiere fiche.
GOOGLE_BUSINESS_ACCOUNT=
GOOGLE_BUSINESS_LOCATION=

# L'URL publique par laquelle ARENA se joint depuis l'exterieur — celle que
# Google (et tout futur fournisseur OAuth) doit rappeler apres un
# consentement. Sur son PC : laisser vide (defaut http://127.0.0.1:8000).
# Sur un serveur heberge (DEC-0021) : l'URL reelle du serveur, sans slash a
# la fin (ex. https://arena.exemple.com).
PUBLIC_BASE_URL=

# Ta journee de travail, telle que l'agenda doit la lire. Declaree ici plutot
# que devinee : proposer un creneau a 3 h du matin serait exact et inutilisable.
AGENDA_HEURE_DEBUT=8
AGENDA_HEURE_FIN=18

# FACEBOOK + INSTAGRAM — Meta Graph API (DEC-0179)
# Un seul jeton de PAGE pour les deux reseaux. Marche a suivre pas a pas :
# docs/CONNECTER_MES_COMPTES.md. Sans ces valeurs, JARVIS rapporte
# NOT_CONFIGURED : il ne publie rien et ne pretend rien avoir lu.
# Publier ou repondre demande TOUJOURS ton accord (config/permissions_services.yaml).
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
# Le compte Instagram professionnel relie a la page (vide = Instagram non relie).
META_IG_USER_ID=
# Version de la Graph API (vide = v23.0). Meta retire une version environ
# deux ans apres sa sortie : a changer ici si Meta annonce la fin de celle-ci.
META_GRAPH_VERSION=

# LINKEDIN — PUBLIER SUR TON PROFIL (DEC-0183)
# Jeton d'acces d'une application LinkedIn avec les produits « Sign In with
# LinkedIn using OpenID Connect » et « Share on LinkedIn » (autorisations
# openid, profile, w_member_social). Il expire apres 60 jours : il faudra le
# refaire. Marche a suivre : docs/CONNECTER_MES_COMPTES.md.
LINKEDIN_ACCESS_TOKEN=
# Version de l'API (AAAAMM, vide = 202509). A changer si LinkedIn la retire.
LINKEDIN_API_VERSION=

# TIKTOK — PUBLIER TES VIDEOS (DEC-0185)
# L'identifiant de ton application TikTok for Developers (produits Login Kit
# et Content Posting API, scopes video.publish et video.upload).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Le jeton de renouvellement (valable un an). JARVIS en tire chaque jour un
# jeton d'acces de 24 h, et garde le nouveau si TikTok le change.
TIKTOK_REFRESH_TOKEN=
# Ou, pour un premier essai seulement : un jeton d'acces (il expire en 24 h).
TIKTOK_ACCESS_TOKEN=
# Visibilite des videos publiees (vide = SELF_ONLY, visible par toi seul).
# Tant que TikTok n'a pas audite ton application, SELF_ONLY est le seul permis.
TIKTOK_PRIVACY_LEVEL=

# VIDEO COURTE — MoneyPrinterTurbo (service separe, lance par toi)
# Il fabrique une video verticale a partir d'un sujet : script, plans, voix,
# sous-titres, montage. ARENA lui parle par son API ; aucune ligne de ce projet
# n'entre dans ce depot.
# Installation : scripts/installer_moneyprinter.ps1
# Lancement    : python -m uvicorn app.asgi:app --host 127.0.0.1 --port 8080
# ATTENTION, dans SON config.toml a lui (pas ici) :
#   llm_provider = "ollama"   <- sinon tes scripts video partent chez un
#                                fournisseur d'IA, ce que DEC-0002 refuse.
#   pexels_api_keys = [...]   <- sa banque de plans. Cle gratuite sur pexels.com.
MONEYPRINTER_URL=http://127.0.0.1:8080/api/v1
# Seulement s'il a mis une cle dans son [app] api_key. Vide sinon.
MONEYPRINTER_API_KEY=

# NETRONOME (sante reseau : debit, latence, perte de paquets, DNS) —
# autobrr/netronome, GPL-2.0-or-later. Service SEPARE, lance par le
# proprietaire (DEC-0202) ; aucune ligne n'entre dans ce depot (sa licence GPL
# se propagerait a ce depot public). ARENA lit son API depuis la meme machine.
# OPTIONNEL : sans lui, ARENA retombe sur sa sonde reseau native.
# Installation : binaire autobrr/netronome, puis `netronome serve`.
# Pour qu'ARENA lise l'API sans session, whiteliste-le dans son config.toml :
#   [auth]
#   whitelist = ["127.0.0.1/32"]
NETRONOME_URL=http://127.0.0.1:7575
# A ne remplir QUE si Netronome n'est pas whiteliste : valeur du cookie de
# session. Le chemin recommande est la whitelist ci-dessus, pas ce cookie.
NETRONOME_SESSION=

# OPENTAKEOFF (metre de plan PDF, chapitre plaquiste) — Kentucky-ai, Apache-2.0
# Le moteur de metre. Comme MoneyPrinterTurbo : installe A COTE (DEC-0008),
# jamais dans ce depot. Contrairement a lui, ce n'est pas un service HTTP —
# son serveur MCP ne parle que sur l'entree/sortie standard d'un processus
# Node ; ARENA le lance lui-meme a chaque metre, puis l'arrete.
# Installation : scripts/installer_opentakeoff.ps1, ou a la main —
#   git clone https://github.com/Kentucky-ai/opentakeoff
#   cd opentakeoff/web && npm install
#   cd ../mcp && npm install && npm run build
OPENTAKEOFF_MCP_DIR=
# Seulement si "node" n'est pas sur son PATH.
OPENTAKEOFF_NODE_BIN=

# CODEFORMER — restauration locale optionnelle de photos
# Installation explicite et licence : docs/CODEFORMER.md. Aucun poids n'est
# telecharge au demarrage. NTU S-Lab License 1.0 limite l'usage sans autorisation
# au non-commercial : ne pas activer pour un usage commercial sans permission.
USMAN_CODEFORMER_ROOT=
USMAN_CODEFORMER_PYTHON=
USMAN_CODEFORMER_LICENSE_ACCEPTED=false
USMAN_CODEFORMER_TIMEOUT_SECONDS=600
USMAN_CODEFORMER_MAX_PIXELS=16000000
USMAN_CODEFORMER_MAX_SIDE=4096
USMAN_CODEFORMER_CONCURRENCY=1
# Validation commune a toutes les images jointes, avant vision/restauration.
USMAN_MAX_IMAGE_PIXELS=40000000
USMAN_MAX_IMAGE_SIDE=10000

# INFERENCE HYBRIDE (DEC-0009) — local d'abord, cloud pour la vitesse
# Ollama reste le defaut, le repli, et le SEUL chemin pour ce qui est sensible.
#
# Le regime. Le plus ferme gagne :
#   AI_LOCAL_ONLY=true      -> rien ne sort, quoi que disent les autres reglages
#   AI_CLOUD_ENABLED=false  -> pareil
#   AI_MODE=LOCAL_ONLY | HYBRIDE | CLOUD_PREFERRED
#
#   HYBRIDE (defaut)  : PUBLIC et PRIVE peuvent sortir
#   CLOUD_PREFERRED   : + SENSIBLE (tes devis, ton courrier) — choix explicite
#   Un secret ne sort JAMAIS, dans aucun mode. Ce n'est pas un reglage.
AI_MODE=HYBRIDE
AI_CLOUD_ENABLED=true
AI_LOCAL_ONLY=false
# AUTO laisse ARENA choisir. LOCAL, ANTHROPIC, GROQ ou DEEPINFRA forcent la main.
AI_DEFAULT_PROVIDER=AUTO

# Les cles. Vides = le fournisseur est simplement absent, et ARENA le dit.
# Claude, par Anthropic. C'est le meilleur raisonneur des quatre, et le plus
# cher : tarif public au 19/09/2026 pour claude-sonnet-5, 2 $ par million de
# jetons envoyes et 10 $ par million rendus.
#
# Vide = ARENA ne l'essaie meme pas, et rien ne change. Rempli = il passe
# AVANT Groq pour toute demande autorisee a sortir de la machine (voir
# ORDRE_CLOUD dans core/models/routeur.py). Pour garder Groq par defaut tout
# en laissant la cle en place : AI_DEFAULT_PROVIDER=GROQ.
#
# ATTENTION : AI_DAILY_BUDGET ne freinera PAS Claude tant qu'aucun tarif n'est
# saisi dans TARIFS (core/models/usage.py) — /health l'affiche comme
# NON_VERIFIABLE plutot que de pretendre le contraire. Le plafond qui tient
# vraiment aujourd'hui est AI_MAX_CLOUD_REQUESTS_PER_DAY, ci-dessous.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Plafond de longueur d'une reponse. Obligatoire cote Anthropic : il n'y a pas
# de valeur par defaut chez eux.
ANTHROPIC_MAX_TOKENS=16000
# low, medium, high, xhigh, max — combien Claude reflechit avant de repondre.
# Plus haut = meilleur et plus cher. Une valeur hors liste retombe sur high.
ANTHROPIC_EFFORT=high

GROQ_API_KEY=
# Mesure du 30/08/2026 : `llama-3.3-70b-versatile` a ete retire du catalogue
# Groq. Il ne rendait pas une erreur claire — juste un HTTPStatusError a chaque
# appel, que rien ici ne pouvait distinguer d'une cle refusee. La liste vivante
# est sur https://api.groq.com/openai/v1/models, et c'est elle qui fait foi.
GROQ_MODEL=openai/gpt-oss-120b
DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Garde-fous de depense. Atteints, ARENA retombe sur Ollama — il ne s'arrete pas.
# 0 = pas de plafond, et c'est un choix qui doit etre ecrit.
AI_MAX_CLOUD_REQUESTS_PER_DAY=200
AI_MAX_COST_PER_REQUEST=0.02
AI_DAILY_BUDGET=1.0

# Delai de connexion vers le cloud. Court exprès : sans reseau, ARENA bascule
# sur Ollama sans faire attendre une reponse.
AI_CLOUD_CONNECT_TIMEOUT=3.0
AI_CLOUD_TIMEOUT=60.0

# IA LOCALE (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LOCAL_MODEL=qwen3.5:9b
CODER_LOCAL_MODEL=qwen2.5-coder:14b
# Le seuil semantique de 0,45 (core/memory/semantique.py) appartient a
# bge-m3 : il a ete mesure avec lui. Changer ce modele demande de le
# remesurer, sinon la memoire semantique classe au hasard.
EMBEDDINGS_LOCAL_MODEL=bge-m3

# Désactivé sans clé et sans autorisation de la politique cloud.
# MOTEURS OPTIONNELS CLOUD (actifs uniquement avec une cle et une politique compatible)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Chat autonome : POST /api/v1/chat. Cle Bearer USMAN_API_KEY existante.
# OPENAI_API_KEY alimente le modele et text-embedding-3-small.
# AI_LOCAL_ONLY / AI_CLOUD_ENABLED / AI_MODE restent prioritaires.
# Sans cloud autorise : Ollama pour le chat, SQLite pour le rappel lexical.
USMAN_AUTONOMOUS_MODEL=gpt-4.1-mini
USMAN_AUTONOMOUS_TIMEOUT=30
USMAN_AUTONOMOUS_CONTEXT_CHARS=24000
# Defaut : chroma_db a la racine du projet. En conteneur, choisir un volume persistant.
# USMAN_CHROMA_PATH=/app/data/chroma_db
# Facultatif. Sans cle : DuckDuckGo Instant Answer, couverture actualite limitee.
TAVILY_API_KEY=

# PERMISSIONS & SÉCURITÉ
# Les permissions ne sont PAS dans ce fichier. Elles vivaient ici sous la forme
# PERM_READ_FILES, PERM_WRITE_FILES, PERM_EXECUTE_COMMANDS et PERM_AUTO_PUBLISH,
# et aucune n etait lue par le code : les regler ne changeait rien. Une securite
# morte qui ressemble a une securite est pire qu aucune, parce qu on lui fait
# confiance. Elles sont retirees le 2026-08-27.
#
# Deux fichiers, deux roles :
#   config/permissions.yaml            coupe-circuits generaux (9 booleens).
#                                      PUBLISH: false = rien ne se publie, nulle
#                                      part, quoi que dise l autre fichier.
#   config/permissions_services.yaml   le detail par compte, service, action et
#                                      risque. ALLOWED / CONFIRMATION / DENIED.
#
# La plus stricte des deux couches gagne, toujours.
# Repli hors bac a sable : execute le code genere directement sur la machine,
# sans isolation ni limite memoire, quand Docker est inactif.
# Laisser vide. Sans ce flag, ARENA refuse d executer plutot que de degrader.
ALLOW_UNSAFE_EXEC=

# ENVOI DE FICHIERS (/api/upload)
# Taille maximale d'un fichier envoye, en octets. Defaut : 2 Go.
# Seuls les formats audio et video sont acceptes, quelle que soit cette valeur.
USMAN_UPLOAD_MAX_BYTES=2147483648

# LIMITATION DE DEBIT (routes qui appellent le modele)
# Un appel a Ollama occupe la carte graphique plusieurs secondes.
# Au-dela de ce plafond, la reponse est 429 avec un en-tete Retry-After.
USMAN_RATE_LIMIT_REQUESTS=60
USMAN_RATE_LIMIT_WINDOW=60

# NETTOYAGE AUTO (Gestion espace disque)
MAX_MEDIA_STORAGE_GB=10
AUTO_CLEAN_TEMP_MEDIA=true

# MEMOIRE — chiffrement au repos (mission ARENA x AI MEMORY VAULT, DEC-0090)
# Optionnelle : sans elle, la memoire fonctionne exactement comme avant, en
# clair. Ne la remplir que pour marquer certains souvenirs `sensible=True`
# (core/memory/personnelle.py::retenir) — alors REQUISE, sinon `retenir()`
# refuse plutot que d'ecrire en clair sous couvert de securite.
# Generer une valeur unique :  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Une phrase oubliee rend les souvenirs sensibles deja ecrits definitivement
# illisibles — aucun recouvrement, par construction (core/memory/chiffrement.py).
USMAN_MEMORY_VAULT_PASSPHRASE=

# MEMOIRE — serveur MCP (core/mcp/memory_server.py, DEC-0090)
# Le meme fichier que le backend par defaut ; a ne remplir que pour pointer
# le serveur MCP sur un fichier different.
USMAN_MEMORY_DB_PATH=

# CODEBASE MEMORY MCP (core/connectors/codebase_memory.py, DEC-0201)
# Binaire local pour le graphe de connaissances structurel du code (DeusData, MIT).
# Par defaut : recherche sur le PATH ("codebase-memory-mcp").
USMAN_CODEBASE_MEMORY_BIN=

# SHORTS A PARTIR D'UNE VIDEO LONGUE (core/connectors/youtube_shorts.py, DEC-0207)
# Moteur MIT installe A COTE d'ARENA (jamais dans le depot) :
#   git clone https://github.com/Anil-matcha/AI-Youtube-Shorts-Generator
#   git -C AI-Youtube-Shorts-Generator checkout a57bb938ba50bf9654c2d5ca2af1295163454349
#   python -m venv .venv && .venv/bin/pip install -r requirements-local.txt
#   .venv/bin/pip install "opencv-python-headless>=4.8,<5"   # OpenCV 5 casse le recadrage
# Vide -> capacite NON_CONFIGURE, jamais une video promise qui n'arrivera pas.
YOUTUBE_SHORTS_PATH=
YOUTUBE_SHORTS_PYTHON=
# Classement des extraits : n'importe quel endpoint compatible OpenAI, l'Ollama
# local par exemple (http://127.0.0.1:11434/v1). La cle est DISTINCTE de celle
# d'ARENA : le moteur ne recoit jamais OPENAI_API_KEY.
YOUTUBE_SHORTS_LLM_BASE_URL=
YOUTUBE_SHORTS_LLM_MODEL=
YOUTUBE_SHORTS_LLM_API_KEY=
# Delai maximal d'une generation, en secondes (defaut 1800).
YOUTUBE_SHORTS_TIMEOUT=
