{
  "id": "youtube_shorts",
  "name": "AI Youtube Shorts Generator",
  "purpose": "Decouper une video longue locale en N shorts verticaux classes par potentiel viral, recadres en suivant les visages",
  "upstream": "https://github.com/Anil-matcha/AI-Youtube-Shorts-Generator",
  "pinned_commit": "a57bb938ba50bf9654c2d5ca2af1295163454349",
  "license": "MIT",
  "audit": "docs/audits/ai_youtube_shorts_audit_2026-09-30.md",
  "vendored_in_arena": false,
  "execution_mode": "subprocess_local",
  "engine_mode": "local",
  "api_mode_enabled": false,
  "api_mode_refused_because": "le mode api televerse la video du proprietaire vers MuAPI, service tiers payant",
  "inputs": ["video_file_local", "transcript_srt", "nombre_clips", "format", "langue"],
  "outputs": ["mp4", "json"],
  "requires": ["ffmpeg", "python>=3.9", "opencv>=4.8,<5", "openai_compatible_llm_endpoint", "arena_transcription"],
  "optional_requires": ["yt-dlp"],
  "not_required": ["gpu", "muapi_api_key", "second_whisper_model"],
  "capabilities": ["generate_shorts", "inspecter_moteur"],
  "health_is_measured": true,
  "callable": true,
  "downloads_implicitly": false,
  "receives_arena_secrets": false,
  "artifact_requires_file_on_disk": true,
  "job_isolation": "media/rendered/shorts-<uuid8>",
  "timeout_seconds_default": 1800,
  "replaces_existing_arena_capability": false,
  "delta_over_clip_selector": "N extraits classes avec score/hook/raison et recadrage suivant les visages, la ou clip_selector rend un extrait unique cadre au centre"
}
