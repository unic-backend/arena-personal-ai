# Secrets et environnement
.env
*.env
!.env.example

# Historique et outillage de developpement
.git
.github
.gitignore
.pytest_cache
.ruff_cache
__pycache__
*.pyc
.venv
venv

# Tests et documentation : inutiles dans l'image de production
tests
docs
scripts/*.ps1

# Donnees et medias : montes en volume, jamais copies dans l'image
data
media
!media/**/.gitkeep

# Environnement fige : l'image installe requirements.txt
requirements.lock.txt

# PWA : reconstruite par l'etape pwa-builder du Dockerfile (npm ci && npm run
# build) a chaque image — le node_modules et le dist du poste de travail ne
# servent a rien ici, et pesent 150+ Mo pour rien dans le contexte envoye.
apps/pwa/node_modules
apps/pwa/dist
