# Environnement Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# Variables d'environnement & Secrets
.env
*.env
!.env.example

# Médias lourds et temporaires
media/incoming/*
media/downloads/*
media/source/*
media/analysis/*
media/clips/*
media/subtitles/*
media/rendered/*
media/approved/*
media/published/*
media/rejected/*
